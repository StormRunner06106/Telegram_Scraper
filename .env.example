# GitHub Configuration
GITHUB_TOKEN=your_github_token_here

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace the values above with your actual credentials
# 3. Get GitHub token from: https://github.com/settings/tokens
# 4. Get Supabase credentials from: Supabase Dashboard → Project Settings → API
# 5. This file (.env) is in .gitignore and won't be committed to git
# 6. Run: python check_env.py to verify your configuration
